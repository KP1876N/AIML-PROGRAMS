14A. LPC2148 — ADC

#include <LPC214x.h>

volatile unsigned int adc_value;

int main()
{
    PINSEL1 |= 0x04000000;

    AD0CR = 0x00200204;

    while(1)
    {
        AD0CR |= (1<<24);

        while(!(AD0DR2 & (1<<31)));

        adc_value = (AD0DR2 >> 6) & 0x3FF;
    }
}



13. ESP32 — Bluetooth Serial Communication

#include "BluetoothSerial.h"

BluetoothSerial BT;

void setup()
{
    Serial.begin(9600);
    BT.begin("ESP32_BT");
}

void loop()
{
    if(BT.available())
    {
        char c = BT.read();

        Serial.print(c);
        BT.print(c);
    }
}



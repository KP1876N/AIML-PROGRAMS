7. LPC2148 — Stepper Motor Clockwise

#include <LPC214x.h>

void delay(void)
{
    int i;
    for(i=0;i<10000;i++);
}

void stepper(void)
{
    IOCLR1 = 0x00FF0000;
    IOSET1 = 0x00040000;
    delay();

    IOCLR1 = 0x00FF0000;
    IOSET1 = 0x00060000;
    delay();

    IOCLR1 = 0x00FF0000;
    IOSET1 = 0x00070000;
    delay();

    IOCLR1 = 0x00FF0000;
    IOSET1 = 0x00050000;
    delay();
}

int main()
{
    IODIR1 = 0xFFFFFFFF;

    while(1)
        stepper();
}



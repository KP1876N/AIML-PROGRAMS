8. LPC2148 — Stepper Motor 90° / 180°

#include <LPC214x.h>

void delay(void)
{
    int i;
    for(i=0;i<10000;i++);
}

void stepCW(void)
{
    IOSET1=0x40000; delay();
    IOSET1=0x60000; delay();
    IOSET1=0x70000; delay();
    IOSET1=0x50000; delay();
}

void stepCCW(void)
{
    IOSET1=0x50000; delay();
    IOSET1=0x70000; delay();
    IOSET1=0x60000; delay();
    IOSET1=0x40000; delay();
}

int main()
{
    int i;

    IODIR1=0xFFFFFFFF;

    for(i=0;i<50;i++)
        stepCW();

    delay();

    for(i=0;i<100;i++)
        stepCCW();

    while(1);
}


